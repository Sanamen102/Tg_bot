# WD10JPVX уже накрутил 812 тыс. циклов парковки головок — ресурс по этому
# параметру исчерпан. Агрессивное энергосбережение паркует головки каждые
# несколько секунд и добивает механику, поэтому отключаем его.
ACTION=="add|change", KERNEL=="sd[a-z]", ENV{ID_SERIAL_SHORT}=="WD-WXB1A8676HVV", RUN+="/usr/sbin/hdparm -B 254 /dev/%k"
